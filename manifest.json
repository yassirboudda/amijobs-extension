{
  "manifest_version": 3,
  "name": "AmiJobs",
  "version": "1.4.60",
  "description": "Auto-apply to jobs across multiple job-application websites with AI-assisted form filling.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "windows",
    "downloads",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://www.hellowork.com/*",
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://fr.indeed.com/*",
    "https://*.indeed.com/*",
    "https://smartapply.indeed.com/*",
    "https://www.glassdoor.com/*",
    "https://*.glassdoor.com/*",
    "https://www.glassdoor.fr/*",
    "https://*.glassdoor.fr/*",
    "https://www.glassdoor.be/*",
    "https://*.glassdoor.be/*",
    "https://www.glassdoor.de/*",
    "https://*.glassdoor.de/*",
    "https://www.glassdoor.nl/*",
    "https://*.glassdoor.nl/*",
    "https://www.glassdoor.at/*",
    "https://*.glassdoor.at/*",
    "https://www.glassdoor.ch/*",
    "https://*.glassdoor.ch/*",
    "https://www.glassdoor.ie/*",
    "https://*.glassdoor.ie/*",
    "https://www.glassdoor.ca/*",
    "https://*.glassdoor.ca/*",
    "https://www.glassdoor.co.uk/*",
    "https://*.glassdoor.co.uk/*",
    "https://www.glassdoor.com.au/*",
    "https://*.glassdoor.com.au/*",
    "https://www.glassdoor.co.nz/*",
    "https://*.glassdoor.co.nz/*",
    "https://www.glassdoor.co.in/*",
    "https://*.glassdoor.co.in/*",
    "https://www.glassdoor.com.br/*",
    "https://*.glassdoor.com.br/*",
    "https://www.glassdoor.com.mx/*",
    "https://*.glassdoor.com.mx/*",
    "https://www.glassdoor.sg/*",
    "https://*.glassdoor.sg/*",
    "https://www.glassdoor.com.hk/*",
    "https://*.glassdoor.com.hk/*",
    "https://www.glassdoor.es/*",
    "https://*.glassdoor.es/*",
    "https://www.glassdoor.it/*",
    "https://*.glassdoor.it/*",
    "https://www.glassdoor.pl/*",
    "https://*.glassdoor.pl/*",
    "https://challenges.cloudflare.com/*",
    "https://*.cloudflare.com/*",
    "https://www.google.com/recaptcha/*",
    "https://www.gstatic.com/recaptcha/*",
    "https://recaptcha.net/*",
    "https://www.recaptcha.net/*",
    "https://api.mistral.ai/*",
    "https://api.2captcha.com/*",
    "https://autocomplete.indeed.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://challenges.cloudflare.com/*",
        "https://*.cloudflare.com/*",
        "https://www.indeed.com/*",
        "https://fr.indeed.com/*",
        "https://*.indeed.com/*",
        "https://smartapply.indeed.com/*",
        "https://www.glassdoor.com/*",
        "https://*.glassdoor.com/*",
        "https://www.glassdoor.fr/*",
        "https://*.glassdoor.fr/*",
        "https://www.glassdoor.be/*",
        "https://*.glassdoor.be/*",
        "https://www.glassdoor.de/*",
        "https://*.glassdoor.de/*",
        "https://www.glassdoor.nl/*",
        "https://*.glassdoor.nl/*",
        "https://www.glassdoor.at/*",
        "https://*.glassdoor.at/*",
        "https://www.glassdoor.ch/*",
        "https://*.glassdoor.ch/*",
        "https://www.glassdoor.ie/*",
        "https://*.glassdoor.ie/*",
        "https://www.glassdoor.ca/*",
        "https://*.glassdoor.ca/*",
        "https://www.glassdoor.co.uk/*",
        "https://*.glassdoor.co.uk/*",
        "https://www.glassdoor.com.au/*",
        "https://*.glassdoor.com.au/*",
        "https://www.glassdoor.co.nz/*",
        "https://*.glassdoor.co.nz/*",
        "https://www.glassdoor.co.in/*",
        "https://*.glassdoor.co.in/*",
        "https://www.glassdoor.com.br/*",
        "https://*.glassdoor.com.br/*",
        "https://www.glassdoor.com.mx/*",
        "https://*.glassdoor.com.mx/*",
        "https://www.glassdoor.sg/*",
        "https://*.glassdoor.sg/*",
        "https://www.glassdoor.com.hk/*",
        "https://*.glassdoor.com.hk/*",
        "https://www.glassdoor.es/*",
        "https://*.glassdoor.es/*",
        "https://www.glassdoor.it/*",
        "https://*.glassdoor.it/*",
        "https://www.glassdoor.pl/*",
        "https://*.glassdoor.pl/*"
      ],
      "js": [
        "content/turnstile-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://challenges.cloudflare.com/*",
        "https://*.cloudflare.com/*"
      ],
      "js": [
        "content/cloudflare-turnstile.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://www.google.com/recaptcha/*",
        "https://recaptcha.net/*",
        "https://www.recaptcha.net/*"
      ],
      "js": [
        "content/google-recaptcha.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://www.hellowork.com/fr-fr/*"
      ],
      "js": [
        "content/company-site.js",
        "content/hellowork.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content/company-site.js",
        "content/linkedin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.indeed.com/*",
        "https://fr.indeed.com/*",
        "https://*.indeed.com/*"
      ],
      "js": [
        "content/geo-boards.js",
        "content/shared-autofill.js",
        "content/company-site.js",
        "content/indeed.js",
        "content/cloudflare-turnstile.js",
        "content/google-recaptcha.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://smartapply.indeed.com/*"
      ],
      "js": [
        "content/geo-boards.js",
        "content/shared-autofill.js",
        "content/company-site.js",
        "content/indeed.js",
        "content/cloudflare-turnstile.js",
        "content/google-recaptcha.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.glassdoor.com/*",
        "https://*.glassdoor.com/*",
        "https://www.glassdoor.fr/*",
        "https://*.glassdoor.fr/*",
        "https://www.glassdoor.be/*",
        "https://*.glassdoor.be/*",
        "https://www.glassdoor.de/*",
        "https://*.glassdoor.de/*",
        "https://www.glassdoor.nl/*",
        "https://*.glassdoor.nl/*",
        "https://www.glassdoor.at/*",
        "https://*.glassdoor.at/*",
        "https://www.glassdoor.ch/*",
        "https://*.glassdoor.ch/*",
        "https://www.glassdoor.ie/*",
        "https://*.glassdoor.ie/*",
        "https://www.glassdoor.ca/*",
        "https://*.glassdoor.ca/*",
        "https://www.glassdoor.co.uk/*",
        "https://*.glassdoor.co.uk/*",
        "https://www.glassdoor.com.au/*",
        "https://*.glassdoor.com.au/*",
        "https://www.glassdoor.co.nz/*",
        "https://*.glassdoor.co.nz/*",
        "https://www.glassdoor.co.in/*",
        "https://*.glassdoor.co.in/*",
        "https://www.glassdoor.com.br/*",
        "https://*.glassdoor.com.br/*",
        "https://www.glassdoor.com.mx/*",
        "https://*.glassdoor.com.mx/*",
        "https://www.glassdoor.sg/*",
        "https://*.glassdoor.sg/*",
        "https://www.glassdoor.com.hk/*",
        "https://*.glassdoor.com.hk/*",
        "https://www.glassdoor.es/*",
        "https://*.glassdoor.es/*",
        "https://www.glassdoor.it/*",
        "https://*.glassdoor.it/*",
        "https://www.glassdoor.pl/*",
        "https://*.glassdoor.pl/*"
      ],
      "js": [
        "content/geo-boards.js",
        "content/shared-autofill.js",
        "content/company-site.js",
        "content/glassdoor.js",
        "content/cloudflare-turnstile.js",
        "content/google-recaptcha.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "AmiJobs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
